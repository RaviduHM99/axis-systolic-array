# Best-Worst Case Scenerio #
# ------------------------ #
create_scenario bc_wc_scenario
set_operating_conditions bc_wc_timing_condition \
        -analysis_type on_chip_variation \
        -min_library 
        -max_library 
set_tlu_plus_files -max_tluplus $tech_files(TLUPLUS_WC) -min_tluplus $tech_files(TLUPLUS_BC) -tech2itf_map $tech_files(TLUPLUS_MAP)
set_scenario_options -scenarios bc_wc_scenario -setup true -hold true -leakge_power false

#    Worst Case Scenerio - LVT   #
# ------------------------------ #
create_scenario wc_scenario_lvt
set_operating_conditions wc_timing_condition \
        -library $tech_files(STANDARD_CELLS_LVT_WC_LIB)
set_tlu_plus_files -max_tluplus $tech_files(TLUPLUS_WC) -tech2itf_map $tech_files(TLUPLUS_MAP)
set_scenario_options -scenarios wc_scenario_lvt -setup true -hold false -leakge_power false

#    Best Case Scenerio - LVT   #
# ----------------------------- #
create_scenario bc_scenario_lvt
set_operating_conditions bc_timing_condition \
        -library $tech_files(STANDARD_CELLS_LVT_BC_LIB)
set_tlu_plus_files -max_tluplus $tech_files(TLUPLUS_BC) -tech2itf_map $tech_files(TLUPLUS_MAP)
set_scenario_options -scenarios bc_scenario_lvt -setup false -hold true -leakge_power false

#  Typical Case Scenerio - LVT   #
# ------------------------------ #
create_scenario typical_scenario_lvt
set_operating_conditions typical_timing_condition \
        -library $tech_files(STANDARD_CELLS_LVT_TC_LIB)
set_tlu_plus_files -max_tluplus $tech_files(TLUPLUS_TC) -tech2itf_map $tech_files(TLUPLUS_MAP)
set_scenario_options -scenarios typical_scenario_lvt -setup true -hold true -leakge_power false

